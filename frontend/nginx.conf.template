# Template of the nginx site config. When the container starts,
# render-nginx-conf.sh replaces each __NAME__ with a value from config.yaml.
server {
    # Browser -> nginx is HTTPS. Certificates are mounted from ./certs (see docker-compose.yml).
    listen 443 ssl;
    http2 on;
    server_name localhost;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # A plain http:// request on this HTTPS port (old bookmarks, old email links) makes nginx
    # raise its internal 497 error; redirect it to the same URL over https instead of showing
    # "400 The plain HTTP request was sent to HTTPS port". $http_host keeps the port the
    # client used (e.g. localhost:3000), since inside the container nginx listens on 443.
    error_page 497 =301 https://$http_host$request_uri;

    # No Strict-Transport-Security (HSTS) here: browsers apply HSTS to the whole host name on
    # every port, so on "localhost" it would force other local dev tools (e.g. Mailpit on
    # http://localhost:8025) onto https. Enable it only when deployed under a real domain.

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    # Only the upload routes may carry a large body: every other request is capped
    # at max_json_body_bytes, since the gateway reads JSON bodies into memory.
    client_max_body_size __MAX_JSON_BODY_BYTES__;

    # File upload (US-2.2). The upload limit is max_upload_bytes plus room for the
    # multipart framing, and a little more, so the gateway answers an oversized file
    # with its own clear "too large" message instead of nginx's bare 413.
    # The body is streamed through instead of being spooled to disk a second time,
    # and upload_timeout lets a slow connection finish a big file.
    location = /api/files/upload {
        client_max_body_size __MAX_UPLOAD_REQUEST_BYTES__;
        proxy_request_buffering off;
        proxy_read_timeout __UPLOAD_TIMEOUT__;
        proxy_send_timeout __UPLOAD_TIMEOUT__;

        proxy_pass https://api-gateway:8443/api/files/upload;
        proxy_http_version 1.1;

        proxy_ssl_verify              on;
        proxy_ssl_trusted_certificate /etc/nginx/certs/ca.crt;
        proxy_ssl_name                api-gateway;
        proxy_ssl_server_name         on;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/api/files/[^/]+/version$ {
        client_max_body_size __MAX_UPLOAD_REQUEST_BYTES__;
        proxy_request_buffering off;
        proxy_read_timeout __UPLOAD_TIMEOUT__;
        proxy_send_timeout __UPLOAD_TIMEOUT__;

        proxy_pass https://api-gateway:8443;
        proxy_http_version 1.1;

        proxy_ssl_verify              on;
        proxy_ssl_trusted_certificate /etc/nginx/certs/ca.crt;
        proxy_ssl_name                api-gateway;
        proxy_ssl_server_name         on;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # nginx -> api-gateway is HTTPS too; the gateway certificate is verified
    # against our local CA, using the Docker hostname "api-gateway" (in the cert's SAN).
    location /api/ {
        proxy_pass https://api-gateway:8443/api/;
        proxy_http_version 1.1;

        proxy_ssl_verify              on;
        proxy_ssl_trusted_certificate /etc/nginx/certs/ca.crt;
        proxy_ssl_name                api-gateway;
        proxy_ssl_server_name         on;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
