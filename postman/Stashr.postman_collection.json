  "item": [
    {
      "name": "Register",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Petar\",\n  \"lastName\": \"Petrovic\",\n  \"email\": \"{{email}}\",\n  \"password\": \"Aaaaaaaa!0\",\n  \"confirmPassword\": \"Aaaaaaaa!0\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "register"]
            },
            "description": "Creates an unverified user. Open http://localhost:8025 (Mailpit), copy the verification token from the email, paste it into the Verify account request, then send that request."
          },
          "response": []
        },
        {
          "name": "Verify account",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/verify?token=PASTE_VERIFICATION_TOKEN",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "verify"],
              "query": [
                {
                  "key": "token",
                  "value": "PASTE_VERIFICATION_TOKEN"
                }
              ]
            },
            "description": "Replace PASTE_VERIFICATION_TOKEN with the token from the Mailpit verification email (the value after ?token= in the link). Expect 200 when the account is activated."
          },
          "response": []
        }
      ]
    },
