    {
      "name": "Password reset",
      "item": [
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "forgot-password"]
            },
            "description": "Expect 200 with a generic message even if the email does not exist.\n\nIf the user exists, open Mailpit (http://localhost:8025), copy the token from the reset link, and paste it into the collection variable resetToken.\n\nA new request invalidates any previous unused link.\n\nFresh accounts cannot change password until passwordLastChanged is at least 24h old. Backdate in Mongo before Check reset link / Submit new password:\n\ndocker exec -it users_mongodb mongosh users_db --eval \"db.users.updateOne({ email: 'mail@mail.com' }, { $set: { passwordLastChanged: new Date(Date.now() - 25*60*60*1000) } })\""
          },
          "response": []
        },
        {
          "name": "Check reset link",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/reset-password?token={{resetToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "reset-password"],
              "query": [
                {
                  "key": "token",
                  "value": "{{resetToken}}"
                }
              ]
            },
            "description": "Paste resetToken from Mailpit first.\n\n200 — link is valid and password is older than 24h.\n403 — password is younger than 24h; body includes retryAt.\n400 — invalid, expired, or already used; canRequestNewLink is true."
          },
          "response": []
        },
        {
          "name": "Submit new password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"NewStrong1!\",\n  \"confirmPassword\": \"NewStrong1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "reset-password"]
            },
            "description": "Expect 200 Password updated. Then log in with NewStrong1! using Login korisnika (update that request body password) and paste OTP from Mailpit into the otp collection variable.\n\nSending the same token again must return 400 generic with canRequestNewLink."
          },
          "response": []
        },
        {
          "name": "Forgot unknown email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "forgot-password"]
            },
            "description": "Expect 200 with the same generic message as a real user. Mailpit should not get a new email."
          },
          "response": []
        },
        {
          "name": "Check reset link (no token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "reset-password"]
            },
            "description": "Expect 400 generic JSON: invalid or expired, canRequestNewLink true, forgotPasswordPath /api/users/forgot-password."
          },
          "response": []
        },
        {
          "name": "Submit weak password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"weak\",\n  \"confirmPassword\": \"weak\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "reset-password"]
            },
            "description": "Expect 400 plain text password-rules error. This is input validation, not the generic invalid-link JSON."
          },
          "response": []
        },
        {
          "name": "Forgot password (rate limit)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "forgot-password"]
            },
            "description": "Send this (or Forgot password) four times within 15 minutes for the same existing email. The 4th successful-window request should return 429 Too many password reset requests."
          },
          "response": []
        }
      ]
    }
  ],
