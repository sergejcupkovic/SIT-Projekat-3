MONGO_PORT=27017
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
USERS_GRPC_PORT=50051
STORAGE_GRPC_PORT=50052
GATEWAY_PORT=8443
FRONTEND_PORT=3000

# Object store (S3 API) that holds uploaded file contents. The key pair must match s3.json.
# Local development defaults only - never reuse them anywhere else.
OBJECT_STORE_ACCESS_KEY=stashr-dev
OBJECT_STORE_SECRET_KEY=stashr-dev-secret-change-me
OBJECT_STORE_BUCKET=stashr-files
OBJECT_STORE_API_PORT=9000
OBJECT_STORE_UI_PORT=9001

# Largest single file accepted by gateway and storage-service, in bytes (default 200 MiB).
# nginx (frontend/nginx.conf, client_max_body_size) must allow a little more.
MAX_UPLOAD_BYTES=209715200

JWT_SECRET=M886d0BXLo4XgPqwuE9W6a+tzplWs51ekmH824b/pi4=

RATE_LIMIT_PER_SECOND=1
RATE_LIMIT_BURST=20
